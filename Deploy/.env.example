# Configuration reference. The example secret values are for local development
# only; generate and manage real production secrets securely.
# Production deployment domain (the deployment scripts default to this value).
ASTERLOOM_DOMAIN=asterloom.momiya.cloud
CERTBOT_EMAIL=admin@asterloom.momiya.cloud
POSTGRES_PASSWORD=asterloom-dev
MINIO_ROOT_USER=asterloom
MINIO_ROOT_PASSWORD=asterloom-dev-secret
REDIS_PASSWORD=asterloom-redis-dev
# Generate with: openssl rand -hex 32
TELEMETRY_INGESTION_API_KEY=asterloom-telemetry-dev
ASTERLOOM_BOOTSTRAP_ADMIN_NAME="Local Administrator"
ASTERLOOM_BOOTSTRAP_ADMIN_EMAIL=admin@asterloom.local
ASTERLOOM_BOOTSTRAP_ADMIN_PASSWORD=Asterloom-Local-Admin!2026
ASTERLOOM_OIDC_CLIENT_SECRET=Asterloom-Web-Local-Secret!2026
