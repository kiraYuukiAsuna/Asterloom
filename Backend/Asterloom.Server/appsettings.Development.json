{
  "Persistence": {
    "Provider": "Memory"
  },
  "Identity": {
    "Issuer": "http://localhost:5080/",
    "WebClient": {
      "ClientId": "asterloom-web",
      "RedirectUri": "http://localhost:3000/api/auth/callback",
      "PostLogoutRedirectUri": "http://localhost:3000/api/auth/logout/callback"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
