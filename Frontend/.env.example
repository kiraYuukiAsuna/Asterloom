ASTERLOOM_BACKEND_URL=http://127.0.0.1:5080
ASTERLOOM_PASSPORT_PUBLIC_URL=http://localhost:5080
ASTERLOOM_WEB_ORIGIN=http://localhost:3000
ASTERLOOM_OIDC_ISSUER=http://localhost:5080
ASTERLOOM_OIDC_CLIENT_ID=asterloom-web
# Required for a production BFF; inject through a secret manager.
ASTERLOOM_OIDC_CLIENT_SECRET=
ASTERLOOM_SESSION_STORE=memory
# Production uses redis and requires these values.
ASTERLOOM_SESSION_REDIS_URL=redis://127.0.0.1:6379/0
ASTERLOOM_SESSION_REDIS_PASSWORD=
# Base64-encoded 32-byte AES key. Generate with: openssl rand -base64 32
ASTERLOOM_SESSION_ENCRYPTION_KEY=
# Never enable in a production deployment; intended for local HTTP Compose only.
ASTERLOOM_ALLOW_INSECURE_DEVELOPMENT=false
